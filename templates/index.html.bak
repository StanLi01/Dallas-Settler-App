<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>The Settler App</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
html[data-theme="dark"]{
  --bg:#0b1120; --panel:#151f33; --panel2:#1c2740; --border:#2b3852;
  --text:#e8eefc; --muted:#8fa0bf; --accent:#4cc2ff; --accent-ink:#04121f;
  --danger:#ff7a7a; --warn:#ffc861; --ok:#67e8a0; --shadow:rgba(0,0,0,.45);
}
html[data-theme="light"]{
  --bg:#f4f6fb; --panel:#ffffff; --panel2:#eef2f9; --border:#d8e0ee;
  --text:#0f1b2d; --muted:#5b6b85; --accent:#0a84d1; --accent-ink:#ffffff;
  --danger:#d9433f; --warn:#b7791f; --ok:#128a55; --shadow:rgba(16,32,64,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);
     transition:background .25s ease,color .25s ease}
.app-header{background:var(--panel);border-bottom:1px solid var(--border);
  padding:0 22px;height:60px;display:flex;align-items:center;gap:14px;
  box-shadow:0 1px 12px var(--shadow);position:relative;z-index:900}
.brand{display:flex;align-items:baseline;gap:10px}
.brand h1{font-size:1.15rem;font-weight:800;letter-spacing:-.2px}
.brand span{color:var(--muted);font-size:.8rem}
.header-right{margin-left:auto;display:flex;align-items:center;gap:10px}
.pill{background:var(--panel2);border:1px solid var(--border);border-radius:999px;
  padding:6px 14px;font-size:.75rem;color:var(--muted);display:flex;align-items:center;gap:8px}
.pill b{color:var(--text);font-weight:700}
.theme-btn{background:var(--panel2);border:1px solid var(--border);color:var(--text);
  border-radius:999px;padding:7px 16px;font-size:.8rem;font-weight:600;cursor:pointer;
  display:flex;align-items:center;gap:8px;transition:.15s}
.theme-btn:hover{border-color:var(--accent);color:var(--accent)}
.container{display:flex;height:calc(100vh - 60px)}
.sidebar{width:400px;min-width:360px;overflow-y:auto;background:var(--panel);
  border-right:1px solid var(--border);display:flex;flex-direction:column}
.map-area{flex:1;position:relative}
#map{width:100%;height:100%;background:var(--bg)}
.section{padding:16px 20px;border-bottom:1px solid var(--border)}
.section h2{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;
  color:var(--muted);margin-bottom:11px;font-weight:700}
.search-row{display:flex;gap:8px}
.search-row input{flex:1;padding:11px 14px;border-radius:10px;border:1px solid var(--border);
  background:var(--panel2);color:var(--text);font-size:.92rem;outline:none;transition:.15s}
.search-row input:focus{border-color:var(--accent)}
.search-row button{padding:11px 20px;border:none;border-radius:10px;cursor:pointer;
  font-weight:700;font-size:.88rem;background:var(--accent);color:var(--accent-ink);transition:.15s}
.search-row button:hover{filter:brightness(1.08)}
.search-row button:disabled{opacity:.6;cursor:default}
.coords-label{font-family:ui-monospace,Menlo,monospace;font-size:.76rem;color:var(--ok);margin-top:9px}
#load-badge{background:var(--panel2);border:1px solid var(--border);border-radius:8px;
  padding:8px 11px;font-size:.75rem;color:var(--muted);margin-top:9px;
  display:flex;align-items:center;gap:8px;line-height:1.4}
.weather-card{display:flex;gap:18px;align-items:center}
.weather-card .temp{font-size:2rem;font-weight:800;letter-spacing:-1px}
.weather-card .detail{color:var(--muted);font-size:.82rem;line-height:1.6}
.weather-card .detail b{color:var(--text)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat-card{background:var(--panel2);border:1px solid var(--border);border-radius:10px;
  padding:13px 10px;text-align:center}
.stat-card .num{font-size:1.6rem;font-weight:800;letter-spacing:-.5px}
.stat-card .lbl{font-size:.7rem;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.04em}
.type-row{margin-bottom:9px}
.type-row .top{display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:4px;gap:10px}
.type-row .top span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.type-row .top b{color:var(--text);flex-shrink:0}
.bar{height:6px;background:var(--panel2);border-radius:999px;overflow:hidden}
.bar>i{display:block;height:100%;background:var(--accent);border-radius:999px}
.crime-list{max-height:260px;overflow-y:auto;margin:0 -4px;padding:0 4px}
.crime-item{padding:9px 0;border-bottom:1px solid var(--border);font-size:.83rem}
.crime-item:last-child{border-bottom:none}
.crime-item .type{font-weight:650;line-height:1.35}
.crime-item .meta{color:var(--muted);font-size:.75rem;margin-top:3px}
.dist{color:var(--accent);font-weight:700}
.hv-row{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:.85rem}
.hv-row .yr{color:var(--muted);width:38px;flex-shrink:0}
.hv-row .track{flex:1;height:7px;background:var(--panel2);border-radius:999px;overflow:hidden}
.hv-row .track>i{display:block;height:100%;background:var(--ok);border-radius:999px}
.hv-row .val{font-weight:700;width:78px;text-align:right;flex-shrink:0}
.map-controls{position:absolute;top:12px;right:12px;z-index:800;display:flex;flex-direction:column;gap:7px}
.map-controls label{background:var(--panel);border:1px solid var(--border);border-radius:10px;
  padding:9px 14px;font-size:.8rem;cursor:pointer;display:flex;align-items:center;gap:9px;
  user-select:none;box-shadow:0 2px 10px var(--shadow);font-weight:600}
.map-controls input[type=checkbox]{accent-color:var(--accent);width:15px;height:15px}
.map-legend{position:absolute;bottom:22px;left:22px;z-index:800;background:var(--panel);
  border:1px solid var(--border);border-radius:12px;padding:14px 17px;font-size:.78rem;
  box-shadow:0 4px 18px var(--shadow)}
.map-legend h3{margin-bottom:9px;font-size:.7rem;text-transform:uppercase;
  letter-spacing:.1em;color:var(--muted);font-weight:700}
.legend-item{display:flex;align-items:center;gap:9px;margin-bottom:6px}
.legend-item:last-child{margin-bottom:0}
.legend-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid var(--border);
  border-top-color:var(--accent);border-radius:50%;animation:spin .6s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.hidden{display:none!important}
.msg-empty{color:var(--muted);font-size:.82rem;font-style:italic;padding:9px 0}
.sidebar::-webkit-scrollbar,.crime-list::-webkit-scrollbar{width:8px}
.sidebar::-webkit-scrollbar-thumb,.crime-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}

/* Arrow marker */
.arrow-marker{background:none;border:none}
.arrow-marker svg{display:block;filter:drop-shadow(0 3px 5px rgba(0,0,0,.5));
  animation:arrowDrop .45s cubic-bezier(.2,1.4,.4,1)}
@keyframes arrowDrop{from{transform:translateY(-16px);opacity:0}to{transform:translateY(0);opacity:1}}

/* Compact, unobtrusive attribution */
.leaflet-control-attribution{background:rgba(0,0,0,.45)!important;color:#c9d6ee!important;
  font-size:9px!important;padding:1px 6px!important;border-radius:4px 0 0 0}
.leaflet-control-attribution a{color:#8fb8e8!important}
html[data-theme="light"] .leaflet-control-attribution{
  background:rgba(255,255,255,.7)!important;color:#5b6b85!important}
html[data-theme="light"] .leaflet-control-attribution a{color:#0a84d1!important}

@media(max-width:900px){
  .container{flex-direction:column}
  .sidebar{width:100%;min-width:unset;max-height:52vh}
}
</style>
</head>
<body>

<header class="app-header">
  <div class="brand">
    <h1>The Settler App</h1>
    <span>Dallas Crime &amp; Neighborhood Intel</span>
  </div>
  <div class="header-right">
    <div class="pill" id="header-count">Crime data: <b>loading…</b></div>
    <button class="theme-btn" id="theme-toggle">
      <span id="theme-icon">☀️</span><span id="theme-label">Light mode</span>
    </button>
  </div>
</header>

<div class="container">
<aside class="sidebar">

  <div class="section">
    <h2>Search Address</h2>
    <div class="search-row">
      <input id="addr-input" type="text" placeholder="e.g. 4400 Lemmon Ave, Dallas TX"/>
      <button id="btn-lookup">Go</button>
    </div>
    <div id="coords-display" class="coords-label hidden"></div>
    <div id="load-badge"></div>
  </div>

  <div id="weather-section" class="section hidden">
    <h2>Current Weather</h2>
    <div class="weather-card">
      <div class="temp" id="w-temp">--</div>
      <div class="detail">
        <div id="w-cond">--</div>
        <div id="w-wind"></div>
        <div id="w-precip"></div>
      </div>
    </div>
  </div>

  <div id="stats-section" class="section hidden">
    <h2>Crime Summary</h2>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="num" id="s-history" style="color:var(--danger)">0</div>
        <div class="lbl">At address</div>
      </div>
      <div class="stat-card">
        <div class="num" id="s-nearby" style="color:var(--warn)">0</div>
        <div class="lbl">Within 1 km</div>
      </div>
    </div>
  </div>

  <div id="types-section" class="section hidden">
    <h2>Top Crime Types Within 1 km</h2>
    <div id="types-list"></div>
  </div>

  <div id="hv-section" class="section hidden">
    <h2>Median Home Value · Census ACS 5-yr</h2>
    <div id="hv-list"></div>
  </div>

  <div id="history-section" class="section hidden">
    <h2>Crime History at This Address</h2>
    <div id="history-list" class="crime-list"></div>
  </div>

  <div id="nearby-section" class="section hidden">
    <h2>Nearest Crimes Within 1 km</h2>
    <div id="nearby-list" class="crime-list"></div>
  </div>

</aside>

<div class="map-area">
  <div id="map"></div>
  <div class="map-controls">
    <label><input type="checkbox" id="tog-crimes" checked/> All crime points</label>
    <label><input type="checkbox" id="tog-buffer" checked/> 1 km buffer</label>
  </div>
  <div class="map-legend">
    <h3>Legend</h3>
    <div class="legend-item"><span class="legend-dot" style="background:#ff5c5c"></span> Individual crime</div>
    <div class="legend-item"><span class="legend-dot" style="background:transparent;border:2px solid var(--accent)"></span> 1 km buffer</div>
    <div class="legend-item">
      <svg width="12" height="14" viewBox="0 0 24 30" style="flex-shrink:0">
        <path d="M12 30 L3 9 L12 13 L21 9 Z" fill="#4cc2ff" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      Searched address
    </div>
  </div>
</div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"><\/script>
<script>
/* Esri ArcGIS Online canvas tiles — free, no API key, no watermark */
var TILES = {
  dark:  'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}',
  light: 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}'
};
var ATTR = 'Tiles &copy; Esri';

var theme = 'dark';
var tileLayer = null;

function applyTheme(next){
  theme = next;
  document.documentElement.setAttribute('data-theme', theme);
  document.getElementById('theme-icon').textContent  = theme === 'dark' ? '☀️' : '🌙';
  document.getElementById('theme-label').textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
  if (tileLayer) map.removeLayer(tileLayer);
  tileLayer = L.tileLayer(TILES[theme], {maxZoom:19, attribution:ATTR}).addTo(map);
  tileLayer.bringToBack();
}

var canvasRenderer = L.canvas({padding:0.5});
var map = L.map('map', {
  zoomControl:true, preferCanvas:true,
  attributionControl:true
}).setView([32.78,-96.80], 11);

/* Drop the Leaflet flag from the attribution bar — keeps it to one short line */
map.attributionControl.setPrefix('');

var crimeLayer  = L.layerGroup().addTo(map);
var bufferLayer = L.layerGroup().addTo(map);
var searchMarker = null;

applyTheme('dark');

document.getElementById('theme-toggle').addEventListener('click', function(){
  applyTheme(theme === 'dark' ? 'light' : 'dark');
});
document.getElementById('tog-crimes').addEventListener('change', function(e){
  e.target.checked ? map.addLayer(crimeLayer) : map.removeLayer(crimeLayer);
});
document.getElementById('tog-buffer').addEventListener('change', function(e){
  e.target.checked ? map.addLayer(bufferLayer) : map.removeLayer(bufferLayer);
});

/* Arrow icon — tip sits exactly on the coordinate */
var arrowIcon = L.divIcon({
  className: 'arrow-marker',
  html: '<svg width="30" height="38" viewBox="0 0 24 30">' +
        '<path d="M12 30 L3 9 L12 13 L21 9 Z" fill="#4cc2ff" stroke="#ffffff" ' +
        'stroke-width="1.6" stroke-linejoin="round"/></svg>',
  iconSize: [30, 38],
  iconAnchor: [15, 38],
  popupAnchor: [0, -34]
});

var badge = document.getElementById('load-badge');
var headerCount = document.getElementById('header-count');
function setBadge(html){ badge.innerHTML = html; }

setBadge('<span class="spinner"></span> Contacting Dallas Open Data…');

var pollTimer = setInterval(async function(){
  try{
    var p = await (await fetch('/api/crimes/progress')).json();
    if (p.error){
      setBadge('⚠️ ' + esc(p.error));
      clearInterval(pollTimer);
    } else if (p.status === 'fetching'){
      setBadge('<span class="spinner"></span> Fetched ' + p.fetched.toLocaleString() + ' records…');
    } else if (p.status === 'done'){
      clearInterval(pollTimer);
    }
  }catch(e){}
}, 1200);

(async function loadCrimePoints(){
  try{
    var gj = await (await fetch('/api/crimes/geojson')).json();
    clearInterval(pollTimer);

    if(!gj.features.length){
      setBadge('⚠️ No crime data returned — check the server console.');
      headerCount.innerHTML = 'Crime data: <b>0</b>';
      return;
    }

    crimeLayer.clearLayers();
    gj.features.forEach(function(f){
      var c = f.geometry.coordinates, p = f.properties;
      L.circleMarker([c[1], c[0]], {
        renderer: canvasRenderer, radius: 2,
        fillColor:'#ff5c5c', color:'#ff5c5c', weight:0, fillOpacity:0.55
      }).bindPopup(
        '<b>'+esc(p.t)+'</b><br>'+esc(p.a)+'<br><span style="opacity:.65">'+esc(p.y)+'</span>'
      ).addTo(crimeLayer);
    });

    var n = gj.features.length.toLocaleString();
    setBadge('✅ ' + n + ' crime locations plotted');
    headerCount.innerHTML = 'Crime data: <b>' + n + '</b>';
  }catch(e){
    console.error(e);
    clearInterval(pollTimer);
    setBadge('⚠️ Error loading data: ' + esc(e.message || String(e)));
  }
})();

var addrInput = document.getElementById('addr-input');
var btnLookup = document.getElementById('btn-lookup');
addrInput.addEventListener('keydown', function(e){ if(e.key === 'Enter') btnLookup.click(); });

btnLookup.addEventListener('click', async function(){
  var address = addrInput.value.trim();
  if(!address) return;
  btnLookup.innerHTML = '<span class="spinner"></span>';
  btnLookup.disabled = true;

  try{
    var lr = await fetch('/api/lookup', {method:'POST',
      headers:{'Content-Type':'application/json'}, body:JSON.stringify({address:address})});
    if(!lr.ok){ var er = await lr.json(); alert(er.error || 'Lookup failed'); return; }
    var loc = await lr.json();
    var km = loc.buffer_km || 1;

    document.getElementById('coords-display').textContent =
      '📍 ' + loc.lat.toFixed(5) + ', ' + loc.lon.toFixed(5);
    document.getElementById('coords-display').classList.remove('hidden');

    var w = loc.weather;
    document.getElementById('w-temp').textContent  = w.temp_f != null ? w.temp_f + '°F' : '--';
    document.getElementById('w-cond').textContent  = w.condition || '--';
    document.getElementById('w-wind').innerHTML    = w.wind_mph != null ? 'Wind <b>'+w.wind_mph+' mph</b>' : '';
    document.getElementById('w-precip').innerHTML  = w.precip_pct != null ? 'Rain <b>'+w.precip_pct+'%</b>' : '';
    document.getElementById('weather-section').classList.remove('hidden');

    bufferLayer.clearLayers();
    if(searchMarker) map.removeLayer(searchMarker);

    var center = [loc.lat, loc.lon];
    var ring = L.circle(center, {
      radius: km * 1000,
      color:'#4cc2ff', weight:2.5, dashArray:'8 5',
      fillColor:'#4cc2ff', fillOpacity:0.08
    }).addTo(bufferLayer);
    ring.bindTooltip(km + ' km buffer', {direction:'top'});

    searchMarker = L.marker(center, {icon: arrowIcon, zIndexOffset: 1000})
      .addTo(bufferLayer)
      .bindPopup('<b>Search location</b><br>'+esc(address))
      .openPopup();

    map.flyToBounds(ring.getBounds().pad(0.25), {duration:1.2});

    var data = await (await fetch('/api/analyze', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({address:address, lat:loc.lat, lon:loc.lon})})).json();

    document.getElementById('s-history').textContent = data.history_count.toLocaleString();
    document.getElementById('s-nearby').textContent  = data.nearby_count.toLocaleString();
    document.getElementById('stats-section').classList.remove('hidden');

    var typesEl = document.getElementById('types-list');
    if(data.nearby_by_type && data.nearby_by_type.length){
      var max = data.nearby_by_type[0].count || 1;
      typesEl.innerHTML = data.nearby_by_type.map(function(t){
        var pct = Math.round(t.count / max * 100);
        return '<div class="type-row"><div class="top"><span>'+esc(t.type)+'</span><b>'+
               t.count.toLocaleString()+'</b></div><div class="bar"><i style="width:'+pct+'%"></i></div></div>';
      }).join('');
      document.getElementById('types-section').classList.remove('hidden');
    }

    var hvEl = document.getElementById('hv-list');
    if(data.home_values && data.home_values.length){
      var vals = data.home_values.map(function(h){ return h.value || 0; });
      var hvMax = Math.max.apply(null, vals) || 1;
      hvEl.innerHTML = data.home_values.map(function(hv){
        var pct = hv.value ? Math.round(hv.value / hvMax * 100) : 0;
        return '<div class="hv-row"><span class="yr">'+hv.year+'</span>'+
               '<span class="track"><i style="width:'+pct+'%"></i></span>'+
               '<span class="val">'+(hv.value ? '$'+hv.value.toLocaleString() : 'N/A')+'</span></div>';
      }).join('');
      document.getElementById('hv-section').classList.remove('hidden');
    }

    var histEl = document.getElementById('history-list');
    histEl.innerHTML = data.history_crimes.length
      ? data.history_crimes.map(function(c){
          return '<div class="crime-item"><div class="type">'+esc(c.incident_type)+
                 '</div><div class="meta">'+esc(c.address)+' · '+esc(c.year)+'</div></div>';
        }).join('')
      : '<div class="msg-empty">No crime reported at this exact address.</div>';
    document.getElementById('history-section').classList.remove('hidden');

    var nearEl = document.getElementById('nearby-list');
    if(!data.nearby_crimes.length){
      nearEl.innerHTML = '<div class="msg-empty">No crimes found within '+km+' km.</div>';
    } else {
      nearEl.innerHTML = data.nearby_crimes.map(function(c){
        return '<div class="crime-item"><div class="type">'+esc(c.incident_type)+
               '</div><div class="meta"><span class="dist">'+c.distance_km.toFixed(2)+' km</span> · '+
               esc(c.address)+' · '+esc(c.year)+'</div></div>';
      }).join('');
      if(data.nearby_count > data.nearby_crimes.length){
        nearEl.innerHTML += '<div class="msg-empty">Showing nearest '+
          data.nearby_crimes.length+' of '+data.nearby_count.toLocaleString()+' total.</div>';
      }
    }
    document.getElementById('nearby-section').classList.remove('hidden');

  }catch(e){
    console.error(e);
    alert('Something went wrong. Check the browser console.');
  }finally{
    btnLookup.innerHTML = 'Go';
    btnLookup.disabled = false;
  }
});

function esc(s){ if(s == null) return ''; var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
<\/script>
</body>
</html>
